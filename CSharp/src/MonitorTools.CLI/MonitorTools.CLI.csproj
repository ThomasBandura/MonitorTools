<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MonitorTools</AssemblyName>
    <Authors>Thomas Bandura</Authors>
    <Company>Thomas Bandura</Company>
    <Product>MonitorTools CLI</Product>
    <Description>Command-line tool to control Windows monitors via DDC/CI: monitor information, brightness, contrast, volume, input sources, PBP and raw VCP features</Description>
    <PackageTags>monitor;ddc-ci;vcp;pbp;brightness;input;display;windows;cli</PackageTags>
    <IsPackable>false</IsPackable>
    <Copyright>Copyright © 2026</Copyright>
    <PackageProjectUrl>https://github.com/ThomasBandura/MonitorTools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ThomasBandura/MonitorTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Single-file executable configuration -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonitorTools.Core\MonitorTools.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

</Project>
